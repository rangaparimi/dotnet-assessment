# Template for .env (docker compose reads .env automatically).
#   cp .env.example .env     then set your own SA_PASSWORD
# Never commit .env - it holds real secrets.

# SQL Server (container)
# Must be 8+ chars with upper, lower, digit and symbol. Don't use $ or # in it.
SA_PASSWORD=change-me
SQL_PORT=1433

# API
API_PORT=5025
ASPNETCORE_ENVIRONMENT=Development   # Development enables Swagger
APPLY_MIGRATIONS_ON_STARTUP=true     # create/update the database when the API starts

# UI
UI_PORT=5003

# Shared secret between the UI and the API (the UI sends it in the X-Api-Key header)
# Generate one with:  openssl rand -hex 24
API_KEY=change-me

# Google sign-in (OAuth). Create these in the Google Cloud console - see README "Sign-in setup".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Emails that get the Admin role, comma separated. Everyone else who signs in is a Viewer.
ADMIN_EMAILS=you@example.com
