@model Employee
@{
    ViewData["Title"] = "Employees";
    var employees = (List<Employee>)ViewBag.Employees;
    var heldBy = ViewBag.HeldBy as Employee;
    var heldAssets = ViewBag.HeldAssets as List<Allocation>;
    var isEdit = Model.Id != 0;
}

<form asp-action="Save" method="post" class="card">
    <h2>@(isEdit ? $"Edit Employee {Model.EmployeeCode}" : "Add Employee")</h2>
    <input type="hidden" asp-for="Id" />
    <div class="grid">
        <label>Employee Code
            <input asp-for="EmployeeCode" required maxlength="20" placeholder="EMP-001" />
            <span asp-validation-for="EmployeeCode" class="field-error"></span>
        </label>
        <label>Full Name
            <input asp-for="FullName" required maxlength="100" />
            <span asp-validation-for="FullName" class="field-error"></span>
        </label>
        <label>Email
            <input asp-for="Email" type="email" required maxlength="100" />
            <span asp-validation-for="Email" class="field-error"></span>
        </label>
        <label>Department
            <input asp-for="Department" required maxlength="50" />
            <span asp-validation-for="Department" class="field-error"></span>
        </label>
        @if (isEdit)
        {
            <label class="checkbox">
                <input asp-for="IsActive" /> Active
            </label>
        }
    </div>
    <div class="actions">
        <button type="submit" class="primary">Save</button>
        @if (isEdit)
        {
            <a class="button" asp-action="Index">Cancel</a>
        }
    </div>
</form>

<div class="card">
    <h2>Employees</h2>
    <table>
        <thead>
            <tr><th>Code</th><th>Name</th><th>Email</th><th>Department</th><th>Active</th><th></th></tr>
        </thead>
        <tbody>
            @if (employees.Count == 0)
            {
                <tr><td class="empty" colspan="6">No employees yet.</td></tr>
            }
            @foreach (var e in employees)
            {
                <tr>
                    <td>@e.EmployeeCode</td>
                    <td>@e.FullName</td>
                    <td>@e.Email</td>
                    <td>@e.Department</td>
                    <td>@(e.IsActive ? "Yes" : "No")</td>
                    <td>
                        <a class="button small" asp-action="Index" asp-route-heldById="@e.Id">Assets</a>
                        <a class="button small" asp-action="Index" asp-route-editId="@e.Id">Edit</a>
                        <form asp-action="Delete" asp-route-id="@e.Id" method="post" class="inline"
                              data-confirm="Delete employee @e.EmployeeCode?" onsubmit="return confirm(this.dataset.confirm)">
                            <button type="submit" class="small danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (heldBy != null && heldAssets != null)
{
    <div class="card">
        <h2>Assets held by @heldBy.FullName</h2>
        <table>
            <thead>
                <tr><th>Allocation #</th><th>Tag</th><th>Name</th><th>Allocated</th></tr>
            </thead>
            <tbody>
                @if (heldAssets.Count == 0)
                {
                    <tr><td class="empty" colspan="4">This employee holds no assets.</td></tr>
                }
                @foreach (var h in heldAssets)
                {
                    <tr>
                        <td>@h.Id</td>
                        <td>@h.AssetTag</td>
                        <td>@h.AssetName</td>
                        <td>@h.AllocatedDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
