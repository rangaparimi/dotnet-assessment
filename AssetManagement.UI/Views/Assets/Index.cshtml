@model Asset
@{
    ViewData["Title"] = "Assets";
    var assets = (List<Asset>)ViewBag.Assets;
    var isEdit = Model.Id != 0;
    var isAdmin = User.IsInRole("Admin");   // viewers only see the list
}

@if (isAdmin)
{
<form asp-action="Save" method="post" class="card">
    <h2>@(isEdit ? $"Edit Asset {Model.AssetTag}" : "Add Asset")</h2>
    <input type="hidden" asp-for="Id" />
    <div class="grid">
        <label>Asset Tag
            <input asp-for="AssetTag" required maxlength="50" placeholder="LAP-0012" />
            <span asp-validation-for="AssetTag" class="field-error"></span>
        </label>
        <label>Name
            <input asp-for="Name" required maxlength="100" />
            <span asp-validation-for="Name" class="field-error"></span>
        </label>
        <label>Category
            <input asp-for="Category" required maxlength="50" placeholder="Laptop, Monitor, Phone..." />
            <span asp-validation-for="Category" class="field-error"></span>
        </label>
        <label>Serial Number
            <input asp-for="SerialNumber" maxlength="100" />
        </label>
        <label>Purchase Date
            <input asp-for="PurchaseDate" type="date" required />
            <span asp-validation-for="PurchaseDate" class="field-error"></span>
        </label>
        @if (isEdit)
        {
            <label>Status
                <select asp-for="Status">
                    <option>Available</option>
                    <option>Allocated</option>
                    <option>UnderRepair</option>
                    <option>Retired</option>
                </select>
            </label>
        }
    </div>
    <div class="actions">
        <button type="submit" class="primary">Save</button>
        @if (isEdit)
        {
            <a class="button" asp-action="Index">Cancel</a>
        }
    </div>
</form>
}

<div class="card">
    <h2>Assets</h2>
    <table>
        <thead>
            <tr><th>Tag</th><th>Name</th><th>Category</th><th>Serial</th><th>Purchased</th><th>Status</th><th></th></tr>
        </thead>
        <tbody>
            @if (assets.Count == 0)
            {
                <tr><td class="empty" colspan="7">No assets yet.</td></tr>
            }
            @foreach (var a in assets)
            {
                <tr>
                    <td>@a.AssetTag</td>
                    <td>@a.Name</td>
                    <td>@a.Category</td>
                    <td>@a.SerialNumber</td>
                    <td>@a.PurchaseDate?.ToString("yyyy-MM-dd")</td>
                    <td><span class="badge @a.Status">@a.Status</span></td>
                    <td>
                        @if (isAdmin)
                        {
                            <a class="button small" asp-action="Index" asp-route-editId="@a.Id">Edit</a>
                            <form asp-action="Delete" asp-route-id="@a.Id" method="post" class="inline"
                                  data-confirm="Delete asset @a.AssetTag?" onsubmit="return confirm(this.dataset.confirm)">
                                <button type="submit" class="small danger">Delete</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
