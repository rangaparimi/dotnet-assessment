@model AllocationsViewModel
@{
    ViewData["Title"] = "Allocation";
}

<form asp-action="Create" method="post" class="card">
    <h2>Allocate Asset</h2>
    <div class="grid">
        <label>Asset (available only)
            <select asp-for="Form.AssetId" required>
                <option value="">@(Model.AvailableAssets.Count == 0 ? "No available assets" : "Choose an asset")</option>
                @foreach (var a in Model.AvailableAssets)
                {
                    <option value="@a.Id">@a.AssetTag - @a.Name</option>
                }
            </select>
            <span asp-validation-for="Form.AssetId" class="field-error"></span>
        </label>
        <label>Employee (active only)
            <select asp-for="Form.EmployeeId" required>
                <option value="">@(Model.ActiveEmployees.Count == 0 ? "No active employees" : "Choose an employee")</option>
                @foreach (var e in Model.ActiveEmployees)
                {
                    <option value="@e.Id">@e.EmployeeCode - @e.FullName</option>
                }
            </select>
            <span asp-validation-for="Form.EmployeeId" class="field-error"></span>
        </label>
        <label class="wide">Remarks
            <input asp-for="Form.Remarks" maxlength="250" />
            <span asp-validation-for="Form.Remarks" class="field-error"></span>
        </label>
    </div>
    <div class="actions">
        <button type="submit" class="primary">Allocate</button>
    </div>
</form>

<div class="card">
    <div class="card-header">
        <h2>Allocations</h2>
        @* A GET form: changing the filter reloads the page with ?show=... *@
        <form asp-action="Index" method="get">
            <select name="show" onchange="this.form.submit()">
                <option value="active" selected="@(Model.Show == "active")">Active only</option>
                <option value="returned" selected="@(Model.Show == "returned")">Returned only</option>
                <option value="all" selected="@(Model.Show == "all")">All</option>
            </select>
        </form>
    </div>
    <table>
        <thead>
            <tr><th>#</th><th>Asset</th><th>Employee</th><th>Allocated</th><th>Returned</th><th>Condition</th><th>Remarks</th><th></th></tr>
        </thead>
        <tbody>
            @if (Model.Allocations.Count == 0)
            {
                <tr><td class="empty" colspan="8">No allocations.</td></tr>
            }
            @foreach (var x in Model.Allocations)
            {
                <tr>
                    <td>@x.Id</td>
                    <td>@x.AssetTag - @x.AssetName</td>
                    <td>@x.EmployeeCode - @x.EmployeeName</td>
                    <td>@DisplayFormat.DateTime(x.AllocatedDate)</td>
                    <td>@DisplayFormat.DateTime(x.ReturnedDate)</td>
                    <td>@x.ReturnCondition</td>
                    <td>@x.Remarks</td>
                    <td>
                        @if (x.ReturnedDate == null)
                        {
                            <a class="button small" asp-controller="Returns" asp-action="Index" asp-route-allocationId="@x.Id">Return</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
