@model Allocation
@{
    ViewData["Title"] = "Allocation";
    var assets = (List<Asset>)ViewBag.Assets;
    var employees = (List<Employee>)ViewBag.Employees;
    var allocations = (List<Allocation>)ViewBag.Allocations;
    var paged = (PagedResult<Allocation>)ViewBag.Paged;
    var show = (string)ViewBag.Show;
    var isAdmin = User.IsInRole("Admin");   // viewers only see the list
}

@if (isAdmin)
{
<form asp-action="Create" method="post" class="card">
    <h2>Allocate Asset</h2>
    <div class="grid">
        <label>Asset (available only)
            <select asp-for="AssetId" required>
                <option value="">Choose an asset</option>
                @foreach (var a in assets)
                {
                    <option value="@a.Id">@a.AssetTag - @a.Name</option>
                }
            </select>
            <span asp-validation-for="AssetId" class="field-error"></span>
        </label>
        <label>Employee (active only)
            <select asp-for="EmployeeId" required>
                <option value="">Choose an employee</option>
                @foreach (var e in employees)
                {
                    <option value="@e.Id">@e.EmployeeCode - @e.FullName</option>
                }
            </select>
            <span asp-validation-for="EmployeeId" class="field-error"></span>
        </label>
        <label class="wide">Remarks
            <input asp-for="Remarks" maxlength="250" />
        </label>
    </div>
    <div class="actions">
        <button type="submit" class="primary">Allocate</button>
    </div>
</form>
}

<div class="card">
    <div class="card-header">
        <h2>Allocations</h2>
        @* Changing the filter reloads the page with ?show=... *@
        <form asp-action="Index" method="get">
            <select name="show" onchange="this.form.submit()">
                <option value="active" selected="@(show == "active")">Active only</option>
                <option value="returned" selected="@(show == "returned")">Returned only</option>
                <option value="all" selected="@(show == "all")">All</option>
            </select>
        </form>
    </div>
    <table>
        <thead>
            <tr><th>#</th><th>Asset</th><th>Employee</th><th>Allocated</th><th>Returned</th><th>Condition</th><th>Remarks</th><th></th></tr>
        </thead>
        <tbody>
            @if (allocations.Count == 0)
            {
                <tr><td class="empty" colspan="8">No allocations.</td></tr>
            }
            @foreach (var x in allocations)
            {
                <tr>
                    <td>@x.Id</td>
                    <td>@x.AssetTag - @x.AssetName</td>
                    <td>@x.EmployeeCode - @x.EmployeeName</td>
                    <td>@x.AllocatedDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@x.ReturnedDate?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@x.ReturnCondition</td>
                    <td>@x.Remarks</td>
                    <td>
                        @if (isAdmin && x.ReturnedDate == null)
                        {
                            <a class="button small" asp-controller="Returns" asp-action="Index" asp-route-allocationId="@x.Id">Return</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <partial name="_Pager" model="paged" />
</div>
