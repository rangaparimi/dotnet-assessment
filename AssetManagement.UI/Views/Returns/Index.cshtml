@model AssetReturn
@{
    ViewData["Title"] = "Returns";
    var openAllocations = (List<Allocation>)ViewBag.OpenAllocations;
    var returns = (List<AssetReturn>)ViewBag.Returns;
}

<form asp-action="Create" method="post" class="card">
    <h2>Record Return</h2>
    <div class="grid">
        <label>Open allocation
            <select asp-for="AllocationId" required>
                <option value="">Choose an allocation</option>
                @foreach (var x in openAllocations)
                {
                    <option value="@x.Id">#@x.Id: @x.AssetTag held by @x.EmployeeName</option>
                }
            </select>
            <span asp-validation-for="AllocationId" class="field-error"></span>
        </label>
        <label>Condition
            <select asp-for="ReturnCondition">
                <option>Good</option>
                <option>Damaged</option>
            </select>
        </label>
        <label class="wide">Remarks
            <input asp-for="Remarks" maxlength="200" />
        </label>
    </div>
    <div class="actions">
        <button type="submit" class="primary">Record Return</button>
    </div>
</form>

<div class="card">
    <h2>Returned Assets</h2>
    <table>
        <thead>
            <tr><th>#</th><th>Asset</th><th>Employee</th><th>Allocated</th><th>Returned</th><th>Condition</th><th>Asset Status</th><th>Remarks</th></tr>
        </thead>
        <tbody>
            @if (returns.Count == 0)
            {
                <tr><td class="empty" colspan="8">No returns yet.</td></tr>
            }
            @foreach (var r in returns)
            {
                <tr>
                    <td>@r.AllocationId</td>
                    <td>@r.AssetTag - @r.AssetName</td>
                    <td>@r.EmployeeName</td>
                    <td>@r.AllocatedDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@r.ReturnedDate?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@r.ReturnCondition</td>
                    <td><span class="badge @r.AssetStatus">@r.AssetStatus</span></td>
                    <td>@r.Remarks</td>
                </tr>
            }
        </tbody>
    </table>
</div>
